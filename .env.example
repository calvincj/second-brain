# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys (use the NEW publishable/secret keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Voyage AI → dashboard → API keys
VOYAGE_API_KEY=pa-...

# Any long random string; Vercel sends it to /api/cron. Generate: openssl rand -hex 32
CRON_SECRET=
